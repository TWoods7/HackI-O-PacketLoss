# Copy to .env (repo root) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Salt for anonymized premise IDs (P-XXXXXX). Any random string; everyone on the team should use the same one.
PREMISE_SALT=change-me

# Frontend (Vite only exposes vars prefixed with VITE_). Put this one in frontend/.env.local
VITE_GOOGLE_MAPS_API_KEY=

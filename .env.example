# Copy to .env (repo root) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Salt for anonymized premise IDs (P-XXXXXX). Any random string; everyone on the team should use the same one.
PREMISE_SALT=change-me

# Frontend: these two go in frontend/.env.local (Vite only reads env files inside frontend/)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
